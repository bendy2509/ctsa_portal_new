# Variables d'environnement du portail RAMPE.
# Ce fichier est un aide-mémoire : le projet ne le charge pas tout seul. Définissez ces variables
# dans votre hébergeur, votre service système ou votre terminal avant de lancer Django.
# Ne commitez jamais le fichier .env réel.

# --- Production -------------------------------------------------------------
# Active le mode production : clé secrète et hôtes obligatoires, HTTPS forcé, DEBUG désactivé.
DJANGO_ENV=production

# Clé secrète propre à la production. Pour en générer une :
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=

# Noms de domaine servis par le portail, séparés par des virgules.
DJANGO_ALLOWED_HOSTS=rampe.exemple.com

# Origines autorisées pour les formulaires, avec le schéma, séparées par des virgules.
DJANGO_CSRF_TRUSTED_ORIGINS=https://rampe.exemple.com

# Facultatif. Mettre 0 si le HTTPS est entièrement géré en amont et que la redirection boucle.
# DJANGO_SECURE_SSL_REDIRECT=1
# Facultatif. Durée HSTS en secondes (3600 par défaut ; 31536000 une fois le HTTPS validé).
# DJANGO_HSTS_SECONDS=3600

# --- Base de données (SQLite par défaut) --------------------------------------
# DB_ENGINE=postgres
# DB_NAME=ctsa_portal
# DB_USER=
# DB_PASSWORD=
# DB_HOST=127.0.0.1
# DB_PORT=5432

# --- Développement uniquement -------------------------------------------------
# Mot de passe des comptes de démonstration créés par : python manage.py seed_ctsa
# CTSA_SEED_PASSWORD=
