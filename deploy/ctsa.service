[Unit]
Description=CTSA Portail RAMPE (Gunicorn)
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/ctsa
EnvironmentFile=/var/www/ctsa/.env
RuntimeDirectory=ctsa
ExecStart=/var/www/ctsa/.venv/bin/gunicorn \
    --workers 3 \
    --bind unix:/run/ctsa/gunicorn.sock \
    --access-logfile - \
    --error-logfile - \
    config.wsgi:application
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
